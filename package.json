{
  "name": "@axyatech/dsh-plugin-rea",
  "version": "1.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "REA (Reverse Engineer Anything) for DeepSeek Harness: registers the REA MCP server, provides its workflow skill, and adds a REA panel to the left sidebar.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rea",
    "reverse-engineering",
    "mcp",
    "agent"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "skills/**",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-REA",
    "NOTICE"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "author": "Axya Tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axyatech/rea-harness-plugin.git"
  },
  "homepage": "https://github.com/axyatech/rea-harness-plugin#readme",
  "bugs": {
    "url": "https://github.com/axyatech/rea-harness-plugin/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "license": "MIT"
}
